---
interface FAQItem {
  question: string;
  answer: string;
}

const faqs: FAQItem[] = [
  {
    "question": "How does the free allowance work?",
    "answer": "Sign in with Google for three successful transcriptions per day. The allowance follows your account across devices and resets at midnight India time. A failed transcription releases its slot."
  },
  {
    "question": "Which links and files can I use?",
    "answer": "Use a public Instagram Reel, TikTok video or YouTube Short, or upload an MP4, MOV, WebM, M4A, MP3 or WAV file. Clips must contain speech and fit within three minutes and 25 MiB. If a platform restricts a link, you can submit your own copy."
  },
  {
    "question": "Where is my clip processed?",
    "answer": "Our server extracts the audio and runs Whisper. Temporary media is removed after processing. Your account can retrieve the finished transcript for 15 minutes while the service is running."
  },
  {
    "question": "Which files can I save?",
    "answer": "Save the transcript as plain text, or export timed captions as SRT or WebVTT. Check names and timings before you publish."
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map((f) => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer,
    },
  })),
};
---

<section id="faq" class="max-w-4xl mx-auto px-4 sm:px-6 py-16 sm:py-20 border-t border-neutral-200/80 dark:border-neutral-800">
  <!-- FAQ JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="text-center max-w-2xl mx-auto mb-12">
    <p class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-2">Common Questions</p>
    <h2 class="text-2xl sm:text-4xl font-semibold tracking-tight text-neutral-900 dark:text-white">
      Frequently Asked Questions
    </h2>
    <p class="mt-3 text-sm sm:text-base text-neutral-600 dark:text-neutral-400">
      Answers about sign-in, supported media and subtitle exports.
    </p>
  </div>

  <div class="space-y-4">
    {faqs.map((item, idx) => (
      <details class="group p-5 rounded-2xl bg-neutral-50/70 dark:bg-[#1c1c1e] border border-neutral-200/80 dark:border-neutral-800 transition-all [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex items-center justify-between cursor-pointer list-none font-medium text-sm sm:text-base text-neutral-900 dark:text-white">
          <span>{item.question}</span>
          <span class="ml-4 flex-shrink-0 transition-transform duration-200 group-open:rotate-180 text-neutral-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </span>
        </summary>
        <p class="mt-3 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed border-t border-neutral-200/50 dark:border-neutral-800/50 pt-3">
          {item.answer}
        </p>
      </details>
    ))}
  </div>
</section>
