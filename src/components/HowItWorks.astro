---
const steps = [
  {
    step: '01',
    title: 'Paste Reel Link or Drop Video',
    desc: 'Input any Instagram Reel, TikTok, or YouTube Shorts URL, or drop an MP4, MOV, or audio file directly into the tool.',
  },
  {
    step: '02',
    title: 'Browser Runs Neural Whisper',
    desc: 'The browser decodes audio using the native Web Audio API and transcribes speech using OpenAI Whisper inside a background Web Worker.',
  },
  {
    step: '03',
    title: 'Copy, Export & Reuse',
    desc: 'Inspect timestamped speech, copy text paragraphs in one click, or download formatted .SRT / .VTT subtitles and .WAV audio.',
  },
];
---

<section class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-20 border-t border-neutral-200/80 dark:border-neutral-800">
  <div class="text-center max-w-2xl mx-auto mb-14">
    <p class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-2">Simplicity First</p>
    <h2 class="text-2xl sm:text-4xl font-semibold tracking-tight text-neutral-900 dark:text-white">
      How Reeltotranscript works
    </h2>
    <p class="mt-3 text-sm sm:text-base text-neutral-600 dark:text-neutral-400">
      Zero installation, zero server latency, zero privacy concerns.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
    {steps.map((st) => (
      <div class="relative p-6 sm:p-8 rounded-2xl bg-neutral-50/70 dark:bg-[#1c1c1e] border border-neutral-200/80 dark:border-neutral-800">
        <span class="text-3xl font-mono font-bold text-neutral-300 dark:text-neutral-700 block mb-4">
          {st.step}
        </span>
        <h3 class="text-lg font-semibold text-neutral-900 dark:text-white mb-2">
          {st.title}
        </h3>
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
          {st.desc}
        </p>
      </div>
    ))}
  </div>
</section>
