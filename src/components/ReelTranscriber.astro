---
interface Props { headline: string; subheadline: string }
const { headline, subheadline } = Astro.props;
---
<section class="tool mx-auto w-full max-w-3xl px-4 py-10 sm:py-16">
  <header class="mb-8 text-center">
    <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight">{headline}</h1>
    <p class="mx-auto mt-4 max-w-xl text-neutral-600 dark:text-neutral-400">{subheadline}</p>
  </header>
  <div class="rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-5 shadow-sm sm:p-8">
    <p id="account-status" aria-live="polite">Checking sign-in…</p>
    <div class="mt-3 flex flex-wrap gap-3">
      <a id="login" class="action primary" href="/auth/login" hidden>Sign in with Google</a>
      <button id="logout" class="action" type="button" hidden>Sign out</button>
    </div>
    <form id="transcribe-form" class="mt-5 border-t border-neutral-200 dark:border-neutral-700 pt-5" hidden>
      <fieldset>
        <legend class="mb-2 font-semibold">Transcribe from</legend>
        <div class="mb-4 flex flex-wrap gap-5">
          <label><input type="radio" name="source" value="link" checked /> Video link</label>
          <label><input type="radio" name="source" value="file" /> Media file</label>
        </div>
        <label id="link-panel" class="block">Public YouTube, Reel, or TikTok link
          <input id="clip-link" class="field" type="url" inputmode="url" placeholder="https://www.youtube.com/watch?v=... or Instagram Reel / TikTok link" required />
        </label>
        <label id="file-panel" class="block" hidden>Choose audio or video
          <input id="clip-file" class="field" type="file" accept=".mp4,.mov,.m4a,.webm,.mp3,.wav" disabled />
        </label>
        <div class="mt-4">
          <span class="block text-sm font-semibold mb-2">Spoken language &amp; AI model</span>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
            <label class="cursor-pointer rounded-2xl border border-neutral-200 dark:border-neutral-700/80 bg-neutral-50/70 dark:bg-neutral-800/40 px-3 py-2.5 transition has-[:checked]:border-[#0066cc] has-[:checked]:bg-[#0066cc]/8 dark:has-[:checked]:border-[#2997ff] dark:has-[:checked]:bg-[#2997ff]/15">
              <input type="radio" name="language" value="auto" class="sr-only" checked />
              <span class="block font-semibold text-neutral-900 dark:text-white">Auto Detect</span>
              <span class="block text-[11px] text-neutral-500 dark:text-neutral-400 mt-0.5">Any language</span>
            </label>
            <label class="cursor-pointer rounded-2xl border border-neutral-200 dark:border-neutral-700/80 bg-neutral-50/70 dark:bg-neutral-800/40 px-3 py-2.5 transition has-[:checked]:border-[#0066cc] has-[:checked]:bg-[#0066cc]/8 dark:has-[:checked]:border-[#2997ff] dark:has-[:checked]:bg-[#2997ff]/15">
              <input type="radio" name="language" value="en" class="sr-only" />
              <span class="block font-semibold text-neutral-900 dark:text-white">English</span>
              <span class="block text-[11px] text-neutral-500 dark:text-neutral-400 mt-0.5">Fast &amp; crisp</span>
            </label>
            <label class="cursor-pointer rounded-2xl border border-neutral-200 dark:border-neutral-700/80 bg-neutral-50/70 dark:bg-neutral-800/40 px-3 py-2.5 transition has-[:checked]:border-[#0066cc] has-[:checked]:bg-[#0066cc]/8 dark:has-[:checked]:border-[#2997ff] dark:has-[:checked]:bg-[#2997ff]/15">
              <input type="radio" name="language" value="hi" class="sr-only" />
              <span class="block font-semibold text-neutral-900 dark:text-white">Hindi (हिन्दी)</span>
              <span class="block text-[11px] text-neutral-500 dark:text-neutral-400 mt-0.5">Devanagari script</span>
            </label>
            <label class="cursor-pointer rounded-2xl border border-neutral-200 dark:border-neutral-700/80 bg-neutral-50/70 dark:bg-neutral-800/40 px-3 py-2.5 transition has-[:checked]:border-[#0066cc] has-[:checked]:bg-[#0066cc]/8 dark:has-[:checked]:border-[#2997ff] dark:has-[:checked]:bg-[#2997ff]/15">
              <input type="radio" name="language" value="hinglish" class="sr-only" />
              <span class="block font-semibold text-neutral-900 dark:text-white">Hinglish</span>
              <span class="block text-[11px] text-neutral-500 dark:text-neutral-400 mt-0.5">Apex Hinglish AI</span>
            </label>
          </div>
          <p id="language-hint" class="mt-1.5 text-xs text-neutral-500 dark:text-neutral-400">Automatically detects the spoken language.</p>
        </div>
        <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-400">YouTube links extract subtitles instantly (any length). Instagram Reels, TikTok &amp; uploaded files support up to 3 minutes and 25 MiB.</p>
        <div id="challenge" class="mt-4"></div>
        <button class="action primary mt-4" id="submit" type="submit" disabled>Transcribe</button>
      </fieldset>
    </form>
    <p id="notice" role="status" aria-live="polite" class="mt-3 text-sm"></p>
    <noscript>Enable JavaScript to sign in and transcribe a clip.</noscript>
  </div>
  <section id="result" hidden class="mt-6 rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-5 sm:p-8 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight">Your Transcript</h2>
        <p id="view-mode-indicator" class="text-xs text-neutral-500 mt-0.5">Full Speech-to-Text</p>
      </div>

      <!-- Segmented View Switcher -->
      <div class="inline-flex rounded-xl bg-neutral-100 dark:bg-neutral-800 p-1 border border-neutral-200/80 dark:border-neutral-700/60 text-xs font-medium self-start sm:self-auto">
        <button id="view-tab-text" type="button" class="view-tab px-3 py-1.5 rounded-lg bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white shadow-xs transition">Transcript</button>
        <button id="view-tab-timestamps" type="button" class="view-tab px-3 py-1.5 rounded-lg text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition">Timestamps</button>
        <button id="view-tab-srt" type="button" class="view-tab px-3 py-1.5 rounded-lg text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition">SRT Preview</button>
      </div>
    </div>

    <!-- Main Content Display -->
    <div class="min-h-[140px] max-h-[460px] overflow-y-auto custom-scrollbar rounded-2xl bg-neutral-50/70 dark:bg-neutral-950/40 p-4 border border-neutral-200/60 dark:border-neutral-800/60 mb-5">
      <p id="transcript-text" class="whitespace-pre-wrap leading-relaxed select-text text-sm sm:text-base"></p>
      <ol id="segments" class="space-y-2.5 hidden text-xs sm:text-sm"></ol>
      <pre id="srt-preview" class="font-mono text-xs text-neutral-700 dark:text-neutral-300 whitespace-pre-wrap leading-relaxed select-text hidden"></pre>
    </div>

    <!-- AI Smart Tools & Formatting -->
    <div class="mb-5 p-4 rounded-2xl bg-neutral-100/70 dark:bg-neutral-800/40 border border-neutral-200/80 dark:border-neutral-700/60 space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-neutral-900 dark:text-white flex items-center gap-1.5">
          <svg class="w-4 h-4 text-[#0066cc] dark:text-[#2997ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          Smart Tools & Formatting
        </span>
        <span class="text-[11px] text-neutral-500">1-click AI formatting</span>
      </div>
      <div class="flex flex-wrap gap-2 text-xs">
        <button id="ai-summary-btn" type="button" class="px-3 py-1.5 rounded-full bg-white dark:bg-[#252528] border border-neutral-300 dark:border-neutral-700 font-medium text-neutral-800 dark:text-neutral-200 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition">
          📋 Key Takeaways & Summary
        </button>
        <button id="ai-caption-btn" type="button" class="px-3 py-1.5 rounded-full bg-white dark:bg-[#252528] border border-neutral-300 dark:border-neutral-700 font-medium text-neutral-800 dark:text-neutral-200 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition">
          📱 Generate Instagram Caption & Tags
        </button>
        <button id="ai-clean-btn" type="button" class="px-3 py-1.5 rounded-full bg-white dark:bg-[#252528] border border-neutral-300 dark:border-neutral-700 font-medium text-neutral-800 dark:text-neutral-200 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition">
          ✨ Clean Filler Words
        </button>
        <button id="ai-reset-btn" type="button" class="px-3 py-1.5 rounded-full bg-white dark:bg-[#252528] border border-neutral-300 dark:border-neutral-700 font-medium text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition hidden">
          🔄 Restore Original Transcript
        </button>
      </div>
    </div>

    <!-- Export & Copy Actions -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-neutral-200 dark:border-neutral-800">
      <div class="flex flex-wrap gap-2">
        <button type="button" id="copy" class="action primary">Copy text</button>
        {['TXT','SRT','VTT'].map(format => <button type="button" class="action" data-format={format}>Save {format}</button>)}
      </div>
      <p id="export-notice" role="status" class="text-xs text-neutral-500"></p>
    </div>
  </section>
</section>
<script>
  import '../lib/transcription-ui';
</script>
