---
const currentYear = new Date().getFullYear();

const tools = [
  { href: '/', label: 'Instagram Reel to Transcript' },
  { href: '/instagram-reel-to-text', label: 'Reel to Text Converter' },
  { href: '/reel-to-srt', label: 'Reel to SRT Subtitles' },
  { href: '/reel-audio-extractor', label: 'Reel Audio Extractor' },
  { href: '/youtube-shorts-transcript', label: 'YouTube Shorts Transcript' },
  { href: '/tiktok-transcript', label: 'TikTok Video Transcript' },
];

const legal = [
  { href: '/about', label: 'About Us' },
  { href: '/privacy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms of Service' },
  { href: '/contact', label: 'Contact Us' },
];
---

<footer class="mt-auto border-t border-neutral-200 dark:border-neutral-800 bg-[#f5f5f7] dark:bg-[#161617] text-neutral-500 dark:text-neutral-400 transition-colors text-xs">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <!-- Top Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-8 border-b border-neutral-200 dark:border-neutral-800">
      <!-- Col 1: About & Technology -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-lg bg-[#0066cc] dark:bg-[#2997ff] flex items-center justify-center text-white">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/>
            </svg>
          </div>
          <span class="font-semibold text-neutral-900 dark:text-white text-sm">Reeltotranscript</span>
        </div>
        <p class="leading-relaxed max-w-md text-neutral-600 dark:text-neutral-400">
          The privacy-first micro tool for converting Instagram Reels, TikToks, and short videos into clean text and SRT subtitle files. Powered by client-side OpenAI Whisper running directly in your browser.
        </p>
        <div class="pt-2 flex items-center gap-3">
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] bg-neutral-200/70 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
            Client-Side AI
          </span>
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] bg-neutral-200/70 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
            OpenAI Whisper
          </span>
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] bg-neutral-200/70 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
            Zero Data Stored
          </span>
        </div>
      </div>

      <!-- Col 2: Free Micro Tools -->
      <div class="space-y-3">
        <h3 class="font-semibold text-neutral-900 dark:text-white text-xs tracking-wider uppercase">Free Tools</h3>
        <ul class="space-y-2">
          {tools.map((item) => (
            <li>
              <a href={item.href} class="hover:text-neutral-900 dark:hover:text-white transition">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Company & Trust -->
      <div class="space-y-3">
        <h3 class="font-semibold text-neutral-900 dark:text-white text-xs tracking-wider uppercase">Company & Legal</h3>
        <ul class="space-y-2">
          {legal.map((item) => (
            <li>
              <a href={item.href} class="hover:text-neutral-900 dark:hover:text-white transition">
                {item.label}
              </a>
            </li>
          ))}
          <li class="pt-1">
            <a href="mailto:hello@reeltotranscript.com" class="text-[#0066cc] dark:text-[#2997ff] hover:underline">
              hello@reeltotranscript.com
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Legal Notice & Disclaimer -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-neutral-500">
      <p>
        © {currentYear} Reeltotranscript. All rights reserved. Not affiliated with Instagram, Meta, TikTok, or ByteDance.
      </p>
      <p class="flex items-center gap-4">
        <span>Runs locally on Web Audio & Web Workers</span>
        <span>·</span>
        <a href="/privacy" class="hover:underline">Privacy</a>
        <span>·</span>
        <a href="/terms" class="hover:underline">Terms</a>
      </p>
    </div>
  </div>
</footer>
