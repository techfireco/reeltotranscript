---
import Layout from '../layouts/Layout.astro';
import ReelTranscriber from '../components/ReelTranscriber.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FAQSection from '../components/FAQSection.astro';
---

<Layout
  title="Reel to SRT and VTT Subtitles"
  description="Generate timed captions and save an SRT or VTT file for your video editor. Three free transcriptions per account each day."
  keywords="reel to srt, instagram reel subtitle generator, convert reel to srt, auto caption reel srt, srt generator for reels, download reel srt free"
  canonicalPath="/reel-to-srt"
>
  <ReelTranscriber
    headline="Create subtitles for a Reel"
    subheadline="Generate timed captions and save an SRT or VTT file for your video editor."
  />

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12 border-t border-neutral-200/80 dark:border-neutral-800">
    <div class="prose dark:prose-invert max-w-none text-sm text-neutral-600 dark:text-neutral-400 space-y-4">
      <h2 class="text-xl font-semibold text-neutral-900 dark:text-white">Professional Subtitles for Video Creators</h2>
      <p>
        Add captions for viewers watching with the sound off.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        <div class="p-4 rounded-xl bg-neutral-50 dark:bg-neutral-800/40 border border-neutral-200 dark:border-neutral-700/60">
          <h3 class="font-semibold text-neutral-900 dark:text-white text-sm">Time-coded segments</h3>
          <p class="text-xs text-neutral-500 mt-1">Review segment timing and spelling in your editor before publishing.</p>
        </div>
        <div class="p-4 rounded-xl bg-neutral-50 dark:bg-neutral-800/40 border border-neutral-200 dark:border-neutral-700/60">
          <h3 class="font-semibold text-neutral-900 dark:text-white text-sm">Direct Video NLE Import</h3>
          <p class="text-xs text-neutral-500 mt-1">Standard SubRip (.srt) and WebVTT (.vtt) format supported by every major editing suite.</p>
        </div>
      </div>
    </div>
  </section>

  <HowItWorks />
  <FeaturesSection />
  <FAQSection />
</Layout>
