---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us — Reeltotranscript"
  description="Contact the Reeltotranscript team for support, feature requests, partnership inquiries, or feedback."
  canonicalPath="/contact"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-24">
    <div class="mb-10 text-center">
      <p class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-2">We're Here to Help</p>
      <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight text-neutral-900 dark:text-white">
        Contact Us
      </h1>
      <p class="mt-4 text-base text-neutral-600 dark:text-neutral-400 max-w-xl mx-auto leading-relaxed">
        Have questions about transcribing a clip, suggested improvements, or found a bug? Reach out directly.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <!-- Email Support Card -->
      <div class="p-8 rounded-3xl bg-neutral-50/80 dark:bg-[#1c1c1e] border border-neutral-200/80 dark:border-neutral-800 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h2 class="text-lg font-semibold text-neutral-900 dark:text-white">Direct Email</h2>
          <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">
            For technical support, feedback, and general questions:
          </p>
          <a
            href="mailto:hello@reeltotranscript.com"
            class="text-base font-semibold text-[#0066cc] dark:text-[#2997ff] hover:underline mt-4 inline-block"
          >
            hello@reeltotranscript.com
          </a>
        </div>

      </div>

      <!-- FAQ & Guides Card -->
      <div class="p-8 rounded-3xl bg-neutral-50/80 dark:bg-[#1c1c1e] border border-neutral-200/80 dark:border-neutral-800 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h2 class="text-lg font-semibold text-neutral-900 dark:text-white">Need Quick Answers?</h2>
          <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">
            Read about daily limits, supported clips and subtitle formats.
          </p>
          <a
            href="/#faq"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-neutral-900 dark:text-white hover:text-[#0066cc] dark:hover:text-[#2997ff] mt-4"
          >
            Browse FAQs →
          </a>
        </div>

      </div>
    </div>
  </div>
</Layout>
