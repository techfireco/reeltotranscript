---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found (404) — Reeltotranscript"
  description="The page you requested could not be found. Return to Reeltotranscript homepage to transcribe Instagram Reels and short videos."
  canonicalPath="/404"
>
  <div class="max-w-xl mx-auto px-4 py-24 sm:py-32 text-center">
    <div class="w-16 h-16 mx-auto rounded-3xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-neutral-400 mb-6">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
    </div>
    <span class="text-xs font-mono font-semibold uppercase tracking-wider text-neutral-400">Error 404</span>
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-neutral-900 dark:text-white mt-2">
      Page Not Found
    </h1>
    <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-md mx-auto">
      The page you were looking for doesn't exist or has been moved. Use the button below to return to the transcriber.
    </p>
    <div class="mt-8 flex justify-center gap-3">
      <a
        href="/"
        class="px-6 py-2.5 rounded-full text-sm font-semibold bg-[#0066cc] dark:bg-[#2997ff] text-white hover:bg-[#0071e3] transition shadow-sm"
      >
        Back to Home
      </a>
      <a
        href="/contact"
        class="px-6 py-2.5 rounded-full text-sm font-semibold bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition"
      >
        Contact Support
      </a>
    </div>
  </div>
</Layout>
