---
import Layout from '../layouts/Layout.astro';
import ReelTranscriber from '../components/ReelTranscriber.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FAQSection from '../components/FAQSection.astro';
---

<Layout
  title="Instagram Reel Audio Extractor & Transcriber — Free Download"
  description="Extract pristine uncompressed 16kHz audio from any Instagram Reel and transcribe it simultaneously. Download lossless WAV audio and full transcript in seconds."
  keywords="reel audio extractor, extract audio from instagram reel, instagram reel to mp3, reel to wav, download audio from reel, transcribe reel audio"
  canonicalPath="/reel-audio-extractor"
>
  <ReelTranscriber
    headline="Extract & Transcribe Audio from Any Reel"
    subheadline="Separate high-fidelity audio tracks from Instagram Reels, TikToks, and videos. Download clean 16kHz uncompressed WAV audio or read the full speech transcript."
  />

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12 border-t border-neutral-200/80 dark:border-neutral-800">
    <div class="prose dark:prose-invert max-w-none text-sm text-neutral-600 dark:text-neutral-400 space-y-4">
      <h2 class="text-xl font-semibold text-neutral-900 dark:text-white">Direct In-Browser Audio Extraction</h2>
      <p>
        Using the browser's hardware-accelerated Web Audio engine, Reeltotranscript isolates the sound track directly from the video container. No compression artifacts or quality loss, and 100% processed locally on your machine.
      </p>
    </div>
  </section>

  <HowItWorks />
  <FeaturesSection />
  <FAQSection />
</Layout>
