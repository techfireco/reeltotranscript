---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonicalPath?: string;
  schema?: Record<string, any>;
}

const {
  title,
  description,
  keywords = 'reel to transcript, instagram reel transcription, reel to text, reel to srt, transcribe instagram reel, download reel transcript, whisper web transcribe',
  canonicalPath = '',
  schema,
} = Astro.props;

const canonicalUrl = `https://reeltotranscript.com${canonicalPath}`;

// Default WebSite + SoftwareApplication JSON-LD
const defaultSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://reeltotranscript.com/#website',
      'url': 'https://reeltotranscript.com',
      'name': 'Reeltotranscript',
      'description': 'Account-based tool to convert Instagram Reels and short videos into text and SRT subtitles with OpenAI Whisper.',
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://reeltotranscript.com/#app',
      'name': 'Reeltotranscript',
      'operatingSystem': 'All (Web Browser, Chrome, Safari, Edge, Firefox)',
      'applicationCategory': 'MultimediaApplication',
      'offers': {
        '@type': 'Offer',
        'price': '0',
        'priceCurrency': 'USD',
      },
      'featureList': [
        'Server-side Reel transcription',
        'OpenAI Whisper neural speech recognition',
        'SRT and VTT subtitle file export',
        'Temporary server-side media processing',
        'Three free transcriptions per account per day',
      ],
    },
    ...(schema ? [schema] : []),
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={canonicalPath === "/404" ? "noindex" : "index, follow"} />
    <meta name="author" content="Reeltotranscript" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Reeltotranscript" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0066cc" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(defaultSchema)} />

    <!-- Theme initialization script (prevents flash of unstyled theme) -->
    <script src="/theme.js" is:inline></script>
  </head>
  <body class="bg-white dark:bg-black text-[#1d1d1f] dark:text-[#f5f5f7] antialiased selection:bg-[#0066cc]/20 selection:text-[#0066cc] dark:selection:text-[#2997ff]">
    <Navbar currentPath={canonicalPath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
